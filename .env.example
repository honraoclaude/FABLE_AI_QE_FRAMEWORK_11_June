# Copy to .env and fill in. The .env file is gitignored.

# Jira sync
JIRA_BASE_URL=https://yourteam.atlassian.net
JIRA_EMAIL=you@team.com
JIRA_API_TOKEN=ATATT...
JIRA_JQL=status = "Refinement" ORDER BY updated DESC

# AI assessment (Claude API)
# ANTHROPIC_API_KEY=sk-ant-...
# QE_AI_MODEL=claude-sonnet-4-6

# MCP enrichment (optional)
# ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/sse
# ATLASSIAN_MCP_TOKEN=...

# Portal
# PORT=4000
# QE_SEED=0
# QE_DB_PATH=qe-portal.db
